{
    "name": "austral/notify-bundle",
    "type": "symfony-bundle",
    "description": "Austral notify bundle",
    "keywords": [
        "Austral",
        "Notify"
    ],
    "license": "MIT",
    "homepage": "https://austral.dev",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "austral/tools-bundle": "^4.0",
        "austral/email-bundle": "^4.0",
        "symfony/mercure": "^0.6.5",
        "symfony/mercure-bundle": "^0.3.9",
        "lcobucci/jwt": "^4.1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\NotifyBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
